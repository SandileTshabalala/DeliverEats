# Copy to .env.dev (development) or .env.prod (production) and fill in.
# NEVER commit the real files: they hold your database password and JWT secret.

ENV=development
DEBUG=development

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173,http://localhost

# ---- Public URLs ------------------------------------------------------------
# Where customers open the app (PayFast sends them back here after paying)
FRONTEND_URL=http://localhost:5173
# Where the API can be reached FROM THE INTERNET. PayFast calls
#   {PUBLIC_API_URL}/api/v1/payments/payfast/notify
# to confirm each payment, so "localhost" does not work: in development run a
# tunnel (ngrok http 8000 / cloudflared) and put its https URL here.
PUBLIC_API_URL=http://localhost:8000

# ---- PayFast (the PLATFORM's account) ---------------------------------------
# Used ONLY to collect subscription payments from restaurants. Money for food
# orders goes to each restaurant's own PayFast account, which the restaurant
# enters in its Settings screen.
# From https://sandbox.payfast.co.za (testing) or your PayFast dashboard (live):
# Settings -> Integration. The passphrase must match the one set there exactly.
# Recurring billing must be enabled on the account for automatic renewals.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# true = sandbox (no real money). Set to false only with LIVE credentials.
PAYFAST_SANDBOX=true

# Default delivery fee in rands for restaurants that have not set their own.
# Each restaurant sets its real fee (flat or per km) in Restaurant > Settings.
DELIVERY_FEE=0

# ---- Subscriptions ----------------------------------------------------------
# false = nobody is blocked (use while you create plans and assign restaurants).
# true  = a restaurant without a paid-up plan is hidden and cannot take orders.
SUBSCRIPTIONS_ENFORCED=false
# Days a restaurant stays open after its paid period ends
SUBSCRIPTION_GRACE_DAYS=5

# Encrypts restaurants' PayFast keys in the database. Set once and never change
# it (changing it makes saved keys unreadable; restaurants would re-enter them).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ENCRYPTION_KEY=

# ---- SMS: Africa's Talking --------------------------------------------------
# https://account.africastalking.com -> Settings -> API Key.
# Testing: AT_USERNAME=sandbox, a sandbox API key and AT_SANDBOX=true (messages
# appear in the simulator, nothing is charged). Leave empty to switch SMS off.
AT_USERNAME=
AT_API_KEY=
# Optional: a sender name / short code registered with Africa's Talking
AT_SENDER_ID=
AT_SANDBOX=false

# ---- Email: Resend ----------------------------------------------------------
# https://resend.com/api-keys. EMAIL_FROM must use a domain you verified in
# Resend, e.g.  Deliver Eats <orders@yourdomain.co.za>. Leave empty to switch email off.
RESEND_API_KEY=
EMAIL_FROM=

APP_NAME=Deliver Eats
PASSWORD_RESET_MINUTES=30

# ---- First platform owner account -------------------------------------------
# Used once by:  python -m app.db.init_db   (inside Docker:
#   docker compose -f docker-compose.dev.yml exec server python -m app.db.init_db)
# There is no built-in admin login. Password: at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_SURNAME=
ADMIN_CONTACT_NUMBER=

# Folder for uploaded restaurant logos (a Docker volume in production)
UPLOAD_DIR=uploads

# ---- Who runs the platform (shown on invoices and the Privacy and Terms pages)
# Easier: fill these in under Admin > Settings in the app. Values saved there
# win; anything left empty there falls back to these lines.
BUSINESS_NAME=
BUSINESS_ADDRESS=
SUPPORT_EMAIL=
SUPPORT_PHONE=
# Only if the platform is VAT registered: subscription invoices then become tax invoices
BUSINESS_VAT_NUMBER=

# ---- Address lookup (OpenStreetMap Nominatim, free)
# Its usage policy requires a real contact. Empty = the support email from
# Admin > Settings > Business details (set one there before going live).
GEOCODER_CONTACT_EMAIL=
GEOCODER_URL=https://nominatim.openstreetmap.org
# Only find addresses in this country; empty = anywhere
GEOCODER_COUNTRY=za

# Local time of the restaurants, for opening hours (South Africa = 2)
LOCAL_UTC_OFFSET_HOURS=2
